CREATE TABLE excluded_scanlator(
    manga_id INTEGER NOT NULL,
    scanlator TEXT NOT NULL,
    UNIQUE(manga_id, scanlator),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

-- Excluding a scanlator twice excludes it once, so a backup that lists one twice (or a
-- restore retried after a partial failure) drops the repeat instead of failing the entry.
insert:
INSERT INTO excluded_scanlator(manga_id, scanlator)
VALUES (:mangaId, :scanlator)
ON CONFLICT(manga_id, scanlator) DO NOTHING;

remove:
DELETE FROM excluded_scanlator
WHERE manga_id = :mangaId
AND scanlator IN :scanlators;

getExcludedScanlatorsByMangaId:
SELECT scanlator
FROM excluded_scanlator
WHERE manga_id = :mangaId;
